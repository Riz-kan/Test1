<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>Non-cropping Zoom • Drag • Pinch • Close Button</title>
<style>
  :root{
    --ease: cubic-bezier(0.22,1,0.36,1);
    --dur: 520ms;
    --fit-max-w: 88vw;
    --fit-max-h: 88vh;
    --zoom-scale: 2;     /* click zoom target */
    --max-scale: 3.5;    /* pinch/wheel upper bound */
    --thumb-radius: 4px;
  }

  body{ margin:0; padding:32px; font-family:system-ui,Segoe UI,Inter,Arial; background:#fff; }

  /* ===== Thumbnail (kept 3:2 cover for clean card) ===== */
  .thumb-frame{
    width: 360px;
    max-width: 100%;
    aspect-ratio: 2 / 3;
    position: relative;
    overflow: hidden;
    border-radius: var(--thumb-radius);
    cursor: default;
  }
  .thumb-frame img{
    position: absolute; inset: 0;
    width: 100%; height: 100%;
    object-fit: cover;
    user-select: none;
    -webkit-user-drag: none;
    display: block;
  }

  /* ===== Overlay (solid white, no fades) ===== */
  .overlay{
    position: fixed; inset: 0; z-index: 9999;
    background: #fff; display: none;
    touch-action: none;          /* we manage gestures */
    overflow: hidden;
  }
  .overlay.active{ display: block; }

  /* Animating box: flies from thumb → centered fit box */
  .clone{
    position: absolute; top: 0; left: 0;
    transform-origin: top left;
    will-change: transform, width, height;
    transition:
      transform var(--dur) var(--ease),
      width var(--dur) var(--ease),
      height var(--dur) var(--ease);
    border-radius: var(--thumb-radius);
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #fff;            /* no flashes */
  }
  .clone.closing{
    background: transparent;
  }
  .clone.closing .clone-img{
    width: 100%;
    height: 100%;
    max-width: none;
    max-height: none;
    object-fit: cover;
  }

  /* Image inside overlay (never crop) */
  .clone-img{
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
    object-fit: contain;
    user-select: none; -webkit-user-drag: none;
    display: block;
    transform-origin: center center;
    transition: transform 260ms var(--ease);
    will-change: transform;
    cursor: default;
  }

  /* Center target (fit box; no fixed aspect) */
  .target-wrap{
    position: fixed; inset: 0;
    display: grid; place-items: center;
    pointer-events: none;
  }
  .target{
    width: var(--fit-max-w);
    height: var(--fit-max-h);
    visibility: hidden;
  }

  /* Cursors only after centered */
  .overlay.ready .clone-img{ cursor: zoom-in; }
  .overlay.ready.zoomed .clone-img{ cursor: zoom-out; }

  /* Close button */
  .close-btn{
    position: fixed;
    top: 16px; right: 16px;
    width: 44px; height: 44px;
    border: 0; border-radius: 999px;
    background: rgba(0,0,0,0.06);
    backdrop-filter: blur(2px);
    cursor: pointer;
    display: none;               /* only while overlay active */
    align-items: center; justify-content: center;
    z-index: 10000;
  }
  .close-btn svg{ width: 22px; height: 22px; }
  .overlay.active + .close-btn{ display: inline-flex; }

  @media (prefers-reduced-motion: reduce){
    .clone{ transition: none; }
    .clone-img{ transition: none; }
  }
</style>
</head>
<body>

<!-- ===== Thumbnail (click to open) ===== -->
<div id="thumbFrame" class="thumb-frame">
  <img
    id="thumbImg"
    alt="Wooden speaker on a desk"
    src="https://cdn.shopify.com/s/files/1/0623/9718/6166/files/wodenspeaker.jpg?v=1761045324"
    width="2048" height="1152" loading="eager" decoding="async"
  />
</div>

<!-- ===== Overlay / cloning stage ===== -->
<div id="overlay" class="overlay" aria-hidden="true" aria-modal="true" role="dialog">
  <div id="clone" class="clone">
    <img id="cloneImg" class="clone-img" alt="" />
  </div>
  <div class="target-wrap"><div id="target" class="target"></div></div>
</div>

<!-- Close Button (separate so it stays clickable) -->
<button id="closeBtn" class="close-btn" type="button" aria-label="Close (Esc)">
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
       stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <line x1="18" y1="6" x2="6" y2="18"></line>
    <line x1="6" y1="6" x2="18" y2="18"></line>
  </svg>
</button>

<script>
(() => {
  const thumbFrame = document.getElementById('thumbFrame');
  const thumbImg   = document.getElementById('thumbImg');

  const overlay    = document.getElementById('overlay');
  const cloneBox   = document.getElementById('clone');
  const cloneImg   = document.getElementById('cloneImg');
  const targetBox  = document.getElementById('target');
  const closeBtn   = document.getElementById('closeBtn');

  const SRC = thumbImg.currentSrc || thumbImg.src;
  cloneImg.src = SRC;

  /* ===== State ===== */
  let animating = false;
  let isZoomed  = false;
  let currentScale = 1;
  let currentTx = 0, currentTy = 0;

  // Drag state
  let isDragging = false;
  let dragStartX = 0, dragStartY = 0;
  let startTx = 0, startTy = 0;
  const DRAG_THRESHOLD = 5; // px to distinguish click vs drag
  let dragActivated = false;

  // Pinch state
  let pointers = new Map(); // id -> {x,y}
  let pinchStartDist = 0;
  let pinchStartScale = 1;
  let pinchCenter = { x: 0, y: 0 };

  const cssVar = (name, fallback) => {
    const v = getComputedStyle(document.documentElement).getPropertyValue(name).trim();
    return v ? parseFloat(v) : fallback;
  };
  const MAX_SCALE = cssVar('--max-scale', 3.5);
  const CLICK_SCALE = cssVar('--zoom-scale', 2);

  const rect = el => {
    const r = el.getBoundingClientRect();
    return { x:r.left, y:r.top, w:r.width, h:r.height };
  };

  const computeTargetRect = () => rect(targetBox);

  let scrollLocked = false;
  let previousBodyOverflow = '';
  function lockScroll(){
    if (scrollLocked) return;
    previousBodyOverflow = document.body.style.overflow;
    document.body.style.overflow = 'hidden';
    scrollLocked = true;
  }
  function unlockScroll(){
    if (!scrollLocked) return;
    document.body.style.overflow = previousBodyOverflow;
    scrollLocked = false;
  }

  const isRectOffscreen = r => (
    r.bottom <= 0 ||
    r.top    >= window.innerHeight ||
    r.right  <= 0 ||
    r.left   >= window.innerWidth
  );

  /* ===== Clamp panning so no blank space shows ===== */
  function clampPan(dx, dy, scale){
    const box = cloneBox.getBoundingClientRect();
    const natRatio = cloneImg.naturalWidth / cloneImg.naturalHeight;

    let imgW = box.width, imgH = box.height;
    if (box.width / box.height > natRatio){
      imgH = box.height; imgW = imgH * natRatio;
    } else {
      imgW = box.width;  imgH = imgW / natRatio;
    }
    const scaledW = imgW * scale;
    const scaledH = imgH * scale;

    const maxX = Math.max(0, (scaledW - box.width) / 2);
    const maxY = Math.max(0, (scaledH - box.height) / 2);

    return {
      dx: Math.min(maxX, Math.max(-maxX, dx)),
      dy: Math.min(maxY, Math.max(-maxY, dy)),
    };
  }

  function applyTransform(tx, ty, scale){
    currentScale = scale;
    currentTx = tx; currentTy = ty;
    cloneImg.style.transform = `translate(${tx}px, ${ty}px) scale(${scale})`;
  }

  /* ===== Open / Close ===== */
  function openZoom(){
    if (animating) return; animating = true;
    isZoomed = false; currentScale = 1; currentTx = currentTy = 0;
    overlay.classList.remove('zoomed','ready');
    cloneBox.classList.remove('closing');

    const from = rect(thumbFrame);
    overlay.classList.add('active');
    overlay.setAttribute('aria-hidden','false');
    lockScroll();

    Object.assign(cloneBox.style, {
      width: from.w + 'px',
      height: from.h + 'px',
      transform: `translate(${from.x}px, ${from.y}px) scale(1,1)`
    });

    requestAnimationFrame(() => {
      const to = computeTargetRect();
      cloneBox.style.width  = to.w + 'px';
      cloneBox.style.height = to.h + 'px';
      cloneBox.style.transform = `translate(${to.x}px, ${to.y}px) scale(1,1)`;
    });

    cloneBox.addEventListener('transitionend', onOpened, { once: true });
    function onOpened(){
      overlay.classList.add('ready');
      thumbFrame.style.visibility = 'hidden';
      overlay.addEventListener('click', onOverlayBackgroundClick);
      window.addEventListener('keydown', onKey);
      // Gesture handlers
      enableGestureHandlers();
      // Focus close button for accessibility
      closeBtn.focus({ preventScroll: true });
      animating = false;
    }
  }

  function closeZoom(){
    if (animating) return; animating = true;
    overlay.classList.remove('zoomed','ready');
    isZoomed = false;
    applyTransform(0,0,1);

    isDragging = false;
    dragActivated = false;
    pointers.clear();
    window.removeEventListener('pointermove', onPointerMove);
    window.removeEventListener('pointerup', onPointerUp);
    window.removeEventListener('pointercancel', onPointerUp);

    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const startRect = cloneBox.getBoundingClientRect();

    cloneBox.classList.add('closing');

    const originalStyles = {
      transition: cloneBox.style.transition,
      position: cloneBox.style.position,
      left: cloneBox.style.left,
      top: cloneBox.style.top,
      width: cloneBox.style.width,
      height: cloneBox.style.height,
      transform: cloneBox.style.transform,
      zIndex: cloneBox.style.zIndex,
      opacity: cloneBox.style.opacity,
      pointerEvents: cloneBox.style.pointerEvents,
      transformOrigin: cloneBox.style.transformOrigin,
    };

    cloneBox.style.transition = 'none';
    cloneBox.style.position = 'fixed';
    cloneBox.style.left = '0px';
    cloneBox.style.top = '0px';
    cloneBox.style.width = startRect.width + 'px';
    cloneBox.style.height = startRect.height + 'px';
    cloneBox.style.transform = `translate(${startRect.left}px, ${startRect.top}px) scale(1)`;
    cloneBox.style.zIndex = '9999';
    cloneBox.style.opacity = '1';
    cloneBox.style.pointerEvents = 'none';
    void cloneBox.offsetWidth;

    document.body.appendChild(cloneBox);

    overlay.classList.remove('active');
    overlay.setAttribute('aria-hidden','true');

    overlay.removeEventListener('click', onOverlayBackgroundClick);
    window.removeEventListener('keydown', onKey);
    disableGestureHandlers();

    let finished = false;
    let cleanupTimer = null;
    let handleTransitionEnd = null;

    const restoreClone = () => {
      cloneBox.style.transition = originalStyles.transition;
      cloneBox.style.position = originalStyles.position;
      cloneBox.style.left = originalStyles.left;
      cloneBox.style.top = originalStyles.top;
      cloneBox.style.width = originalStyles.width;
      cloneBox.style.height = originalStyles.height;
      cloneBox.style.transform = originalStyles.transform;
      cloneBox.style.zIndex = originalStyles.zIndex;
      cloneBox.style.opacity = originalStyles.opacity;
      cloneBox.style.pointerEvents = originalStyles.pointerEvents;
      cloneBox.style.transformOrigin = originalStyles.transformOrigin;
      overlay.insertBefore(cloneBox, overlay.firstChild);
      cloneBox.classList.remove('closing');
    };

    const finalize = () => {
      if (finished) return;
      finished = true;
      if (cleanupTimer !== null){
        clearTimeout(cleanupTimer);
        cleanupTimer = null;
      }
      if (handleTransitionEnd){
        cloneBox.removeEventListener('transitionend', handleTransitionEnd);
        handleTransitionEnd = null;
      }
      restoreClone();
      if (thumbFrame){
        thumbFrame.style.visibility = 'visible';
      }
      unlockScroll();
      if (thumbFrame?.isConnected){
        thumbFrame.focus?.({ preventScroll: true });
      }
      animating = false;
    };

    if (reduceMotion){
      finalize();
      return;
    }

    requestAnimationFrame(() => {
      if (finished) return;
      const toRect = thumbFrame.isConnected ? thumbFrame.getBoundingClientRect() : null;
      const needsFallback = !toRect || toRect.width === 0 || toRect.height === 0 || isRectOffscreen(toRect);

      if (needsFallback){
        const shrinkRatio = 0.82;
        const targetW = startRect.width * shrinkRatio;
        const targetH = startRect.height * shrinkRatio;
        const offsetX = (startRect.width - targetW) / 2;
        const offsetY = (startRect.height - targetH) / 2;

        cloneBox.style.transition = 'transform 200ms var(--ease), width 200ms var(--ease), height 200ms var(--ease), opacity 200ms var(--ease)';
        void cloneBox.offsetWidth;
        cloneBox.style.opacity = '0';
        cloneBox.style.width = targetW + 'px';
        cloneBox.style.height = targetH + 'px';
        cloneBox.style.transform = `translate(${startRect.left + offsetX}px, ${startRect.top + offsetY}px) scale(1)`;

        handleTransitionEnd = (event) => {
          if (event.target !== cloneBox) return;
          finalize();
        };
        cloneBox.addEventListener('transitionend', handleTransitionEnd);
        cleanupTimer = setTimeout(finalize, 350);
        return;
      }

      cloneBox.style.transition = originalStyles.transition || '';
      void cloneBox.offsetWidth;
      cloneBox.style.width = toRect.width + 'px';
      cloneBox.style.height = toRect.height + 'px';
      cloneBox.style.transform = `translate(${toRect.x}px, ${toRect.y}px) scale(1)`;

      handleTransitionEnd = (event) => {
        if (event.target !== cloneBox) return;
        finalize();
      };
      cloneBox.addEventListener('transitionend', handleTransitionEnd);
      const flightDuration = cssVar('--dur', 520);
      cleanupTimer = setTimeout(finalize, flightDuration + 150);
    });
  }

  function onOverlayBackgroundClick(e){
    // Only close if the pointer is outside the actual image bounds
    const withinClone = cloneBox.contains(e.target);
    if (withinClone){
      const imgRect = cloneImg.getBoundingClientRect();
      const insideImage = (
        e.clientX >= imgRect.left && e.clientX <= imgRect.right &&
        e.clientY >= imgRect.top  && e.clientY <= imgRect.bottom
      );
      if (insideImage) return;
    }
    closeZoom();
  }

  /* ===== Click Zoom (post-center) ===== */
  function onImageClick(e){
    if (!overlay.classList.contains('ready') || animating) return;
    // Ignore if a drag occurred
    if (dragActivated){ dragActivated = false; return; }

    if (!isZoomed){
      const boxRect = cloneBox.getBoundingClientRect();
      const clickX = e.clientX - boxRect.left;
      const clickY = e.clientY - boxRect.top;

      const targetScale = Math.min(CLICK_SCALE, MAX_SCALE);
      const dx = (boxRect.width  / 2 - clickX) * (targetScale - 1);
      const dy = (boxRect.height / 2 - clickY) * (targetScale - 1);
      const clamped = clampPan(dx, dy, targetScale);

      overlay.classList.add('zoomed');
      isZoomed = true;
      applyTransform(clamped.dx, clamped.dy, targetScale);
    } else {
      overlay.classList.remove('zoomed');
      isZoomed = false;
      applyTransform(0,0,1);
    }
  }

  /* ===== Drag to Pan (only when zoomed) ===== */
  function onPointerDown(e){
    if (!overlay.classList.contains('ready')) return;
    if (!isZoomed) return; // keep behavior simple
    e.preventDefault();

    cloneImg.style.transition = 'none'; // live move
    isDragging = true; dragActivated = false;
    dragStartX = e.clientX; dragStartY = e.clientY;
    startTx = currentTx; startTy = currentTy;

    cloneImg.setPointerCapture?.(e.pointerId);
    window.addEventListener('pointermove', onPointerMove, { passive: false });
    window.addEventListener('pointerup', onPointerUp, { passive: false });
    window.addEventListener('pointercancel', onPointerUp, { passive: false });
  }
  function onPointerMove(e){
    if (!isDragging) return;
    const dxRaw = e.clientX - dragStartX;
    const dyRaw = e.clientY - dragStartY;

    if (!dragActivated && (Math.abs(dxRaw) > DRAG_THRESHOLD || Math.abs(dyRaw) > DRAG_THRESHOLD)){
      dragActivated = true;
    }
    const targetTx = startTx + dxRaw;
    const targetTy = startTy + dyRaw;
    const c = clampPan(targetTx, targetTy, currentScale);
    applyTransform(c.dx, c.dy, currentScale);
  }
  function onPointerUp(e){
    isDragging = false;
    cloneImg.releasePointerCapture?.(e.pointerId);
    // Re-enable transitions for click zooms
    cloneImg.style.transition = '';
    window.removeEventListener('pointermove', onPointerMove);
    window.removeEventListener('pointerup', onPointerUp);
    window.removeEventListener('pointercancel', onPointerUp);
  }

  /* ===== Pinch (touch) & Wheel Zoom ===== */
  function enableGestureHandlers(){
    // image click for zoom toggle
    cloneImg.addEventListener('click', onImageClick);
    // drag
    cloneImg.addEventListener('pointerdown', onPointerDown, { passive: false });
    // touch pinch
    overlay.addEventListener('pointerdown', trackPointerStart, { passive: false });
    overlay.addEventListener('pointermove', trackPointerMove, { passive: false });
    overlay.addEventListener('pointerup', trackPointerEnd, { passive: false });
    overlay.addEventListener('pointercancel', trackPointerEnd, { passive: false });
    // wheel zoom
    overlay.addEventListener('wheel', onWheel, { passive: false });
  }
  function disableGestureHandlers(){
    cloneImg.removeEventListener('click', onImageClick);
    cloneImg.removeEventListener('pointerdown', onPointerDown);
    overlay.removeEventListener('pointerdown', trackPointerStart);
    overlay.removeEventListener('pointermove', trackPointerMove);
    overlay.removeEventListener('pointerup', trackPointerEnd);
    overlay.removeEventListener('pointercancel', trackPointerEnd);
    overlay.removeEventListener('wheel', onWheel);
  }

  function trackPointerStart(e){
    // Track for pinch only (need two pointers)
    pointers.set(e.pointerId, { x: e.clientX, y: e.clientY });
    if (pointers.size === 2){
      // Begin pinch
      const [a,b] = [...pointers.values()];
      pinchStartDist = Math.hypot(a.x - b.x, a.y - b.y);
      pinchStartScale = currentScale;
      pinchCenter = midpoint(a, b);
      cloneImg.style.transition = 'none'; // live scale
    }
  }
  function trackPointerMove(e){
    const p = pointers.get(e.pointerId);
    if (!p) return;
    p.x = e.clientX; p.y = e.clientY;

    if (pointers.size === 2){
      e.preventDefault(); // prevent page scroll
      const [a,b] = [...pointers.values()];
      const dist = Math.hypot(a.x - b.x, a.y - b.y);
      if (pinchStartDist <= 0) return;

      const rawScale = (dist / pinchStartDist) * pinchStartScale;
      const targetScale = Math.max(1, Math.min(MAX_SCALE, rawScale));
      zoomAroundPoint(targetScale, pinchCenter.x, pinchCenter.y);
    }
  }
  function trackPointerEnd(e){
    pointers.delete(e.pointerId);
    if (pointers.size < 2){
      // End pinch: snap transform within clamps
      const c = clampPan(currentTx, currentTy, currentScale);
      applyTransform(c.dx, c.dy, currentScale);
      cloneImg.style.transition = '';
    }
  }

  function onWheel(e){
    // Use Ctrl/Meta+wheel to avoid accidental zooms; allow trackpad pinch (often fires wheel with ctrlKey)
    if (!e.ctrlKey && !e.metaKey) return;
    if (!overlay.classList.contains('ready')) return;

    e.preventDefault();
    const box = cloneBox.getBoundingClientRect();
    const focalX = e.clientX;  // absolute viewport coords
    const focalY = e.clientY;

    const step = 0.12;
    const delta = -Math.sign(e.deltaY) * step; // up = zoom in
    const raw = currentScale * (1 + delta);
    const targetScale = Math.max(1, Math.min(MAX_SCALE, raw));

    // If moving from fit→zoomed, mark zoomed state
    if (targetScale > 1 && !isZoomed){
      overlay.classList.add('zoomed'); isZoomed = true;
    }
    if (targetScale === 1 && isZoomed){
      overlay.classList.remove('zoomed'); isZoomed = false;
    }

    zoomAroundPoint(targetScale, focalX, focalY);
  }

  function zoomAroundPoint(targetScale, pageX, pageY){
    const box = cloneBox.getBoundingClientRect();
    // Convert page point to box-local
    const x = pageX - box.left;
    const y = pageY - box.top;

    // Where should the image move so (x,y) tends toward center?
    // Compute current offset from box center
    const cx = box.width / 2;
    const cy = box.height / 2;

    // Desired translation delta to keep focal point under cursor
    const dx = (cx - x) * (targetScale - currentScale);
    const dy = (cy - y) * (targetScale - currentScale);

    const nextTx = currentTx + dx;
    const nextTy = currentTy + dy;

    const clamped = clampPan(nextTx, nextTy, targetScale);
    applyTransform(clamped.dx, clamped.dy, targetScale);
  }

  const midpoint = (a,b) => ({ x:(a.x+b.x)/2, y:(a.y+b.y)/2 });

  /* ===== Keyboard ===== */
  function onKey(e){
    if (e.key === 'Escape'){
      if (isZoomed){
        overlay.classList.remove('zoomed'); isZoomed = false;
        applyTransform(0,0,1);
      } else {
        closeZoom();
      }
    } else if ((e.key === '+' || e.key === '=') && overlay.classList.contains('ready')){
      e.preventDefault();
      const box = cloneBox.getBoundingClientRect();
      const target = Math.min(MAX_SCALE, currentScale * 1.15);
      if (target > 1 && !isZoomed){ overlay.classList.add('zoomed'); isZoomed = true; }
      zoomAroundPoint(target, box.left + box.width/2, box.top + box.height/2);
    } else if (e.key === '-' && overlay.classList.contains('ready')){
      e.preventDefault();
      const box = cloneBox.getBoundingClientRect();
      const target = Math.max(1, currentScale / 1.15);
      if (target === 1 && isZoomed){ overlay.classList.remove('zoomed'); isZoomed = false; }
      zoomAroundPoint(target, box.left + box.width/2, box.top + box.height/2);
    }
  }

  /* ===== Resize: keep centered & re-clamp ===== */
  addEventListener('resize', () => {
    if (!overlay.classList.contains('active') || animating) return;
    const to = computeTargetRect();
    const prev = cloneBox.style.transition;
    cloneBox.style.transition = 'none';
    cloneBox.style.width  = to.w + 'px';
    cloneBox.style.height = to.h + 'px';
    cloneBox.style.transform = `translate(${to.x}px, ${to.y}px) scale(1,1)`;
    void cloneBox.offsetHeight;
    cloneBox.style.transition = prev;

    const c = clampPan(currentTx, currentTy, currentScale);
    applyTransform(c.dx, c.dy, currentScale);
  });

  /* ===== Wire up ===== */
  thumbFrame.addEventListener('click', openZoom);
  closeBtn.addEventListener('click', closeZoom);

  // Prevent image dragging ghost
  [thumbImg, cloneImg].forEach(img => {
    img.addEventListener('dragstart', e => e.preventDefault());
  });

  // Make thumbnail focusable for a11y return
  thumbFrame.tabIndex = 0;
})();
</script>
</body>
</html>
